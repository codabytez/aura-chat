rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Username → uid index. Doc ID is the username itself.
    // Create-only: once claimed, a username can never be changed or deleted.
    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }

    // User profiles — readable by all authenticated users, writable only by owner.
    // Username field is immutable after creation.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.username == resource.data.username;
    }

    // Conversations
    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      // Participants can update conversation metadata (typing, lastMessage, etc.)
      // Includes leaving a group (removing self from participants)
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants;

      // Messages subcollection
      match /messages/{messageId} {
        function inConversation() {
          return request.auth != null
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow read: if inConversation();

        // Anyone in the conversation can create a message — but senderId must match their uid
        allow create: if inConversation()
          && request.resource.data.senderId == request.auth.uid;

        // Update rules — split by who's allowed to change what
        allow update: if inConversation() && (
          // Sender can edit/delete their own message (text, deletedForEveryone, edited flag)
          resource.data.senderId == request.auth.uid
          ||
          // Any participant can update only delivery/read fields (for read receipts)
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deliveredTo', 'readBy', 'status'])
        );

        // Only the original sender can hard-delete a message document
        allow delete: if request.auth != null
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
